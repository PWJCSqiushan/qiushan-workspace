import {Miniflare} from 'miniflare';
import {readdirSync,writeFileSync,existsSync} from 'node:fs';
import assert from 'node:assert/strict';
const mf=new Miniflare({modules:['index.js',...readdirSync('dist/server',{recursive:true}).map(String).filter(p=>p.endsWith('.js')&&p!=='index.js')].map(p=>({type:'ESModule' as const,path:'dist/server/'+p})),compatibilityDate:'2026-05-15',compatibilityFlags:['nodejs_compat'],bindings:{AUTH_MODE:'local'}});
try{for(const [path,name] of [['/','workspace-shell.html'],['/time','time-shell.html']]){const response=await mf.dispatchFetch('http://localhost'+path);assert.equal(response.status,200);const html=await response.text();assert.ok(html.includes('/_next/static/'));assert.ok(!html.includes('qiushan-owner-v1'));for(const m of html.matchAll(/(?:src|href)="(\/_next\/static\/[^"<>]+)"/g))assert.ok(existsSync('dist/client'+m[1]),m[1]);writeFileSync('dist/client/'+name,html);console.log('Built generic shell:',path,Buffer.byteLength(html),'bytes');}}finally{await mf.dispose();}
